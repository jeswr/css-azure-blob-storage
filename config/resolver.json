{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage/^0.0.0/components/context.jsonld"
  ],
  "@graph": [
    {
      "@id": "urn:solid-server-app-setup:default:ShorthandResolver",
      "@type": "CombinedShorthandResolver",
      "resolvers": [
        {
          "CombinedShorthandResolver:_resolvers_key": "urn:solid-server:azure:variable:storageAccountName",
          "CombinedShorthandResolver:_resolvers_value": {
            "@type": "KeyExtractor",
            "key": "azureStorageAccountName"
          }
        },
        {
          "CombinedShorthandResolver:_resolvers_key": "urn:solid-server:azure:variable:storageContainerName",
          "CombinedShorthandResolver:_resolvers_value": {
            "@type": "KeyExtractor",
            "key": "azureStorageContainerName"
          }
        },
        {
          "CombinedShorthandResolver:_resolvers_key": "urn:solid-server:azure:variable:storageRootPath",
          "CombinedShorthandResolver:_resolvers_value": {
            "@type": "KeyExtractor",
            "key": "azureStorageRootPath",
            "defaultValue": "css"
          }
        },
        {
          "CombinedShorthandResolver:_resolvers_key": "urn:solid-server:azure:variable:managedIdentityClientId",
          "CombinedShorthandResolver:_resolvers_value": {
            "@type": "KeyExtractor",
            "key": "azureManagedIdentityClientId",
            "defaultValue": ""
          }
        },
        {
          "CombinedShorthandResolver:_resolvers_key": "urn:solid-server:azure:variable:useManagedIdentity",
          "CombinedShorthandResolver:_resolvers_value": {
            "@type": "KeyExtractor",
            "key": "azureUseManagedIdentity",
            "defaultValue": true
          }
        }
      ]
    }
  ]
}
