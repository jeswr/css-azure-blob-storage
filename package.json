{
  "name": "@jeswr/css-azure-blob-storage",
  "version": "0.1.0",
  "description": "Azure Blob Storage DataAccessor for the Community Solid Server.",
  "keywords": [
    "azure",
    "blob-storage",
    "community-solid-server",
    "solid"
  ],
  "license": "MIT",
  "author": "Jesse Wright <https://github.com/jeswr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/css-azure-blob-storage.git"
  },
  "bugs": {
    "url": "https://github.com/jeswr/css-azure-blob-storage/issues"
  },
  "homepage": "https://github.com/jeswr/css-azure-blob-storage#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-azure-blob-storage/^0.0.0/dist/": "dist/"
  },
  "files": [
    "config",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:components": "componentsjs-generator -s src -c dist/components -r azb -i .componentsignore",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --coverage --runInBand",
    "verify": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "global-logger-factory": "^1.0.0"
  },
  "peerDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3"
  },
  "devDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.13",
    "componentsjs-generator": "^4.3.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "jest-rdf": "^2.0.0",
    "n3": "^2.0.0",
    "opinionated-eslint-config": "0.2.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
